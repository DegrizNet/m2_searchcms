{
    "name": "degriznet/m2_searchcms",
    "description": "Magento 2: CMS pages (and Magelan Blog posts) in the search results, with excerpts, highlighted terms and ranking; Luma and Hyva.",
    "type": "magento2-module",
    "version": "2.0.0",
    "license": "proprietary",
    "authors": [
        {
            "name": "Anže Voh",
            "email": "anze@degriz.net",
            "homepage": "https://degriz.net",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "~8.1.0||~8.2.0||~8.3.0||~8.4.0",
        "magento/framework": "^103.0",
        "magento/module-backend": "^102.0",
        "magento/module-catalog-search": "^102.0",
        "magento/module-cms": "^104.0",
        "magento/module-config": "^101.2",
        "magento/module-search": "^101.1",
        "magento/module-store": "^101.1"
    },
    "suggest": {
        "degriznet/m2_blog": "Search Magelan Blog posts too (setting Search blog posts too)"
    },
    "archive": {
        "exclude": [
            "/.gitattributes",
            "/.gitignore",
            "/.github",
            "/dev"
        ]
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Magelan\\SearchCms\\": ""
        }
    }
}
